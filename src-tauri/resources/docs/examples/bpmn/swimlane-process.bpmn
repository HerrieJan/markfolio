<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="申請者" processRef="Process_Applicant" />
    <bpmn:participant id="Participant_2" name="承認者" processRef="Process_Approver" />
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_Submit" targetRef="Task_Review" />
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_Notify" targetRef="EndEvent_Applicant" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Applicant" name="申請プロセス">
    <bpmn:startEvent id="StartEvent_Applicant" name="申請開始">
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Submit" name="申請書作成">
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Applicant" name="申請完了">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="StartEvent_Applicant" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_Submit" targetRef="EndEvent_Applicant" />
  </bpmn:process>
  <bpmn:process id="Process_Approver" name="承認プロセス">
    <bpmn:task id="Task_Review" name="申請審査">
      <bpmn:outgoing>Flow_B1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Approve" name="承認?">
      <bpmn:incoming>Flow_B1</bpmn:incoming>
      <bpmn:outgoing>Flow_B2</bpmn:outgoing>
      <bpmn:outgoing>Flow_B3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Approve" name="承認処理">
      <bpmn:incoming>Flow_B2</bpmn:incoming>
      <bpmn:outgoing>Flow_B4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Reject" name="却下処理">
      <bpmn:incoming>Flow_B3</bpmn:incoming>
      <bpmn:outgoing>Flow_B5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Notify" name="結果通知">
      <bpmn:incoming>Flow_B4</bpmn:incoming>
      <bpmn:incoming>Flow_B5</bpmn:incoming>
      <bpmn:outgoing>Flow_B6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Approver" name="処理完了">
      <bpmn:incoming>Flow_B6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_B1" sourceRef="Task_Review" targetRef="Gateway_Approve" />
    <bpmn:sequenceFlow id="Flow_B2" name="承認" sourceRef="Gateway_Approve" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_B3" name="却下" sourceRef="Gateway_Approve" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow_B4" sourceRef="Task_Approve" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_B5" sourceRef="Task_Reject" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_B6" sourceRef="Task_Notify" targetRef="EndEvent_Approver" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_2">
    <bpmndi:BPMNPlane id="BPMNPlane_2" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="700" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Applicant_di" bpmnElement="StartEvent_Applicant">
        <dc:Bounds x="172" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="166" y="175" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Submit_di" bpmnElement="Task_Submit">
        <dc:Bounds x="260" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Applicant_di" bpmnElement="EndEvent_Applicant">
        <dc:Bounds x="742" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="736" y="175" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_A1_di" bpmnElement="Flow_A1">
        <di:waypoint x="208" y="150" />
        <di:waypoint x="260" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_A2_di" bpmnElement="Flow_A2">
        <di:waypoint x="360" y="150" />
        <di:waypoint x="742" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_2_di" bpmnElement="Participant_2" isHorizontal="true">
        <dc:Bounds x="120" y="280" width="700" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="260" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Approve_di" bpmnElement="Gateway_Approve" isMarkerVisible="true">
        <dc:Bounds x="415" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="422" y="331" width="36" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approve_di" bpmnElement="Task_Approve">
        <dc:Bounds x="520" y="300" width="100" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject_di" bpmnElement="Task_Reject">
        <dc:Bounds x="520" y="400" width="100" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Notify_di" bpmnElement="Task_Notify">
        <dc:Bounds x="670" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Approver_di" bpmnElement="EndEvent_Approver">
        <dc:Bounds x="702" y="502" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="696" y="545" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_B1_di" bpmnElement="Flow_B1">
        <di:waypoint x="360" y="380" />
        <di:waypoint x="415" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B2_di" bpmnElement="Flow_B2">
        <di:waypoint x="440" y="355" />
        <di:waypoint x="440" y="330" />
        <di:waypoint x="520" y="330" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="448" y="313" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B3_di" bpmnElement="Flow_B3">
        <di:waypoint x="440" y="405" />
        <di:waypoint x="440" y="430" />
        <di:waypoint x="520" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="448" y="433" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B4_di" bpmnElement="Flow_B4">
        <di:waypoint x="620" y="330" />
        <di:waypoint x="645" y="330" />
        <di:waypoint x="645" y="380" />
        <di:waypoint x="670" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B5_di" bpmnElement="Flow_B5">
        <di:waypoint x="620" y="430" />
        <di:waypoint x="645" y="430" />
        <di:waypoint x="645" y="380" />
        <di:waypoint x="670" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B6_di" bpmnElement="Flow_B6">
        <di:waypoint x="720" y="420" />
        <di:waypoint x="720" y="502" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_1_di" bpmnElement="MessageFlow_1">
        <di:waypoint x="310" y="190" />
        <di:waypoint x="310" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_2_di" bpmnElement="MessageFlow_2">
        <di:waypoint x="720" y="340" />
        <di:waypoint x="720" y="240" />
        <di:waypoint x="760" y="240" />
        <di:waypoint x="760" y="168" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
