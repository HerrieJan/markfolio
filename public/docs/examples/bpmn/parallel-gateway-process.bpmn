<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Parallel" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Parallel" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="商品注文&#10;受付">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Receive" name="注文受付">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <!-- 並列開始 -->
    <bpmn:parallelGateway id="Gateway_Fork" name="並列処理&#10;開始">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <!-- 並列タスク1 -->
    <bpmn:task id="Task_Payment" name="決済処理">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <!-- 並列タスク2 -->
    <bpmn:task id="Task_Inventory" name="在庫確認">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <!-- 並列タスク3 -->
    <bpmn:task id="Task_Customer" name="顧客情報&#10;確認">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <!-- 並列結合 -->
    <bpmn:parallelGateway id="Gateway_Join" name="並列処理&#10;結合">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <!-- 検証 -->
    <bpmn:task id="Task_Validate" name="注文確定">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <!-- 2段目の並列開始 -->
    <bpmn:parallelGateway id="Gateway_Fork2" name="配送準備&#10;開始">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Package" name="梱包">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Label" name="配送伝票&#10;作成">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <!-- 2段目の並列結合 -->
    <bpmn:parallelGateway id="Gateway_Join2" name="配送準備&#10;完了">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Ship" name="発送">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Notify" name="顧客通知">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="処理完了">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <!-- シーケンスフロー -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Receive" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_Fork" targetRef="Task_Payment" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_Fork" targetRef="Task_Inventory" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Fork" targetRef="Task_Customer" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Payment" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Inventory" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Customer" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_Join" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Validate" targetRef="Gateway_Fork2" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_Fork2" targetRef="Task_Package" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_Fork2" targetRef="Task_Label" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Package" targetRef="Gateway_Join2" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Label" targetRef="Gateway_Join2" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_Join2" targetRef="Task_Ship" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Ship" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Notify" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Parallel">
    <bpmndi:BPMNPlane id="BPMNPlane_Parallel" bpmnElement="Process_Parallel">
      <!-- 開始イベント -->
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="142" y="275" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- 注文受付 -->
      <bpmndi:BPMNShape id="Task_Receive_di" bpmnElement="Task_Receive">
        <dc:Bounds x="240" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <!-- 並列開始ゲートウェイ -->
      <bpmndi:BPMNShape id="Gateway_Fork_di" bpmnElement="Gateway_Fork">
        <dc:Bounds x="395" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="391" y="282" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- 並列タスク -->
      <bpmndi:BPMNShape id="Task_Payment_di" bpmnElement="Task_Payment">
        <dc:Bounds x="500" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Inventory_di" bpmnElement="Task_Inventory">
        <dc:Bounds x="500" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Customer_di" bpmnElement="Task_Customer">
        <dc:Bounds x="500" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <!-- 並列結合ゲートウェイ -->
      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join">
        <dc:Bounds x="655" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="651" y="282" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- 注文確定 -->
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="760" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <!-- 2段目の並列開始 -->
      <bpmndi:BPMNShape id="Gateway_Fork2_di" bpmnElement="Gateway_Fork2">
        <dc:Bounds x="915" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="911" y="282" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Package_di" bpmnElement="Task_Package">
        <dc:Bounds x="1020" y="150" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Label_di" bpmnElement="Task_Label">
        <dc:Bounds x="1020" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <!-- 2段目の並列結合 -->
      <bpmndi:BPMNShape id="Gateway_Join2_di" bpmnElement="Gateway_Join2">
        <dc:Bounds x="1175" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1171" y="282" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- 発送 -->
      <bpmndi:BPMNShape id="Task_Ship_di" bpmnElement="Task_Ship">
        <dc:Bounds x="1280" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <!-- 顧客通知 -->
      <bpmndi:BPMNShape id="Task_Notify_di" bpmnElement="Task_Notify">
        <dc:Bounds x="1440" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <!-- 終了イベント -->
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1602" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1596" y="275" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- フロー -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="250" />
        <di:waypoint x="240" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="250" />
        <di:waypoint x="395" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="420" y="225" />
        <di:waypoint x="420" y="130" />
        <di:waypoint x="500" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="445" y="250" />
        <di:waypoint x="500" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="420" y="275" />
        <di:waypoint x="420" y="370" />
        <di:waypoint x="500" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="600" y="130" />
        <di:waypoint x="680" y="130" />
        <di:waypoint x="680" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="600" y="250" />
        <di:waypoint x="655" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="600" y="370" />
        <di:waypoint x="680" y="370" />
        <di:waypoint x="680" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="705" y="250" />
        <di:waypoint x="760" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="860" y="250" />
        <di:waypoint x="915" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="940" y="225" />
        <di:waypoint x="940" y="190" />
        <di:waypoint x="1020" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="940" y="275" />
        <di:waypoint x="940" y="310" />
        <di:waypoint x="1020" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1120" y="190" />
        <di:waypoint x="1200" y="190" />
        <di:waypoint x="1200" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1120" y="310" />
        <di:waypoint x="1200" y="310" />
        <di:waypoint x="1200" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="1225" y="250" />
        <di:waypoint x="1280" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <di:waypoint x="1380" y="250" />
        <di:waypoint x="1440" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <di:waypoint x="1540" y="250" />
        <di:waypoint x="1602" y="250" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
