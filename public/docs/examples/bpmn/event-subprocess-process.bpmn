<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Event" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Event" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="処理開始">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_1" name="データ準備">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_2" name="メイン処理">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_3" name="結果確認">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="正常終了">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="EndEvent_1" />

    <!-- エラー処理サブプロセス -->
    <bpmn:subProcess id="SubProcess_Error" name="エラー処理" triggeredByEvent="true">
      <bpmn:startEvent id="StartEvent_Error" name="エラー&#10;発生">
        <bpmn:outgoing>Flow_E1</bpmn:outgoing>
        <bpmn:errorEventDefinition />
      </bpmn:startEvent>
      <bpmn:task id="Task_ErrorLog" name="エラー&#10;ログ記録">
        <bpmn:incoming>Flow_E1</bpmn:incoming>
        <bpmn:outgoing>Flow_E2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_ErrorNotify" name="エラー&#10;通知">
        <bpmn:incoming>Flow_E2</bpmn:incoming>
        <bpmn:outgoing>Flow_E3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="EndEvent_Error" name="エラー終了">
        <bpmn:incoming>Flow_E3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_E1" sourceRef="StartEvent_Error" targetRef="Task_ErrorLog" />
      <bpmn:sequenceFlow id="Flow_E2" sourceRef="Task_ErrorLog" targetRef="Task_ErrorNotify" />
      <bpmn:sequenceFlow id="Flow_E3" sourceRef="Task_ErrorNotify" targetRef="EndEvent_Error" />
    </bpmn:subProcess>

    <!-- タイマー処理サブプロセス -->
    <bpmn:subProcess id="SubProcess_Timer" name="定期実行処理" triggeredByEvent="true">
      <bpmn:startEvent id="StartEvent_Timer" name="5分毎" isInterrupting="false">
        <bpmn:outgoing>Flow_T1</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeCycle>R/PT5M</bpmn:timeCycle>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:task id="Task_Monitor" name="進捗確認">
        <bpmn:incoming>Flow_T1</bpmn:incoming>
        <bpmn:outgoing>Flow_T2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="EndEvent_Timer" name="">
        <bpmn:incoming>Flow_T2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_T1" sourceRef="StartEvent_Timer" targetRef="Task_Monitor" />
      <bpmn:sequenceFlow id="Flow_T2" sourceRef="Task_Monitor" targetRef="EndEvent_Timer" />
    </bpmn:subProcess>

    <!-- メッセージ処理サブプロセス -->
    <bpmn:subProcess id="SubProcess_Message" name="キャンセル処理" triggeredByEvent="true">
      <bpmn:startEvent id="StartEvent_Message" name="キャンセル&#10;要求">
        <bpmn:outgoing>Flow_M1</bpmn:outgoing>
        <bpmn:messageEventDefinition />
      </bpmn:startEvent>
      <bpmn:task id="Task_Cancel" name="処理中断">
        <bpmn:incoming>Flow_M1</bpmn:incoming>
        <bpmn:outgoing>Flow_M2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_Rollback" name="ロールバック">
        <bpmn:incoming>Flow_M2</bpmn:incoming>
        <bpmn:outgoing>Flow_M3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="EndEvent_Message" name="中断完了">
        <bpmn:incoming>Flow_M3</bpmn:incoming>
        <bpmn:terminateEventDefinition />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_M1" sourceRef="StartEvent_Message" targetRef="Task_Cancel" />
      <bpmn:sequenceFlow id="Flow_M2" sourceRef="Task_Cancel" targetRef="Task_Rollback" />
      <bpmn:sequenceFlow id="Flow_M3" sourceRef="Task_Rollback" targetRef="EndEvent_Message" />
    </bpmn:subProcess>

    <!-- バウンダリイベント -->
    <bpmn:boundaryEvent id="BoundaryEvent_Timeout" name="タイムアウト" attachedToRef="Task_2">
      <bpmn:outgoing>Flow_B1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_Timeout" name="タイムアウト&#10;処理">
      <bpmn:incoming>Flow_B1</bpmn:incoming>
      <bpmn:outgoing>Flow_B2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Timeout" name="タイムアウト&#10;終了">
      <bpmn:incoming>Flow_B2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_B1" sourceRef="BoundaryEvent_Timeout" targetRef="Task_Timeout" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="Task_Timeout" targetRef="EndEvent_Timeout" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Event">
    <bpmndi:BPMNPlane id="BPMNPlane_Event" bpmnElement="Process_Event">
      <!-- メインフロー -->
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="146" y="195" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="240" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="390" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="540" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="692" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="686" y="195" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="170" />
        <di:waypoint x="240" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="170" />
        <di:waypoint x="390" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="490" y="170" />
        <di:waypoint x="540" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="640" y="170" />
        <di:waypoint x="692" y="170" />
      </bpmndi:BPMNEdge>

      <!-- バウンダリイベント -->
      <bpmndi:BPMNShape id="BoundaryEvent_Timeout_di" bpmnElement="BoundaryEvent_Timeout">
        <dc:Bounds x="422" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="404" y="235" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Timeout_di" bpmnElement="Task_Timeout">
        <dc:Bounds x="390" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Timeout_di" bpmnElement="EndEvent_Timeout">
        <dc:Bounds x="422" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="404" y="425" width="72" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_B1_di" bpmnElement="Flow_B1">
        <di:waypoint x="440" y="228" />
        <di:waypoint x="440" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_B2_di" bpmnElement="Flow_B2">
        <di:waypoint x="440" y="340" />
        <di:waypoint x="440" y="382" />
      </bpmndi:BPMNEdge>

      <!-- エラーサブプロセス -->
      <bpmndi:BPMNShape id="SubProcess_Error_di" bpmnElement="SubProcess_Error" isExpanded="true">
        <dc:Bounds x="120" y="450" width="350" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Error_di" bpmnElement="StartEvent_Error">
        <dc:Bounds x="152" y="507" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="148" y="550" width="44" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ErrorLog_di" bpmnElement="Task_ErrorLog">
        <dc:Bounds x="220" y="485" width="80" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ErrorNotify_di" bpmnElement="Task_ErrorNotify">
        <dc:Bounds x="330" y="485" width="80" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Error_di" bpmnElement="EndEvent_Error">
        <dc:Bounds x="412" y="507" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="402" y="550" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_E1_di" bpmnElement="Flow_E1">
        <di:waypoint x="188" y="525" />
        <di:waypoint x="220" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E2_di" bpmnElement="Flow_E2">
        <di:waypoint x="300" y="525" />
        <di:waypoint x="330" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E3_di" bpmnElement="Flow_E3">
        <di:waypoint x="410" y="525" />
        <di:waypoint x="412" y="525" />
      </bpmndi:BPMNEdge>

      <!-- タイマーサブプロセス -->
      <bpmndi:BPMNShape id="SubProcess_Timer_di" bpmnElement="SubProcess_Timer" isExpanded="true">
        <dc:Bounds x="520" y="450" width="280" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Timer_di" bpmnElement="StartEvent_Timer">
        <dc:Bounds x="552" y="507" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="550" y="550" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Monitor_di" bpmnElement="Task_Monitor">
        <dc:Bounds x="630" y="485" width="80" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Timer_di" bpmnElement="EndEvent_Timer">
        <dc:Bounds x="742" y="507" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_T1_di" bpmnElement="Flow_T1">
        <di:waypoint x="588" y="525" />
        <di:waypoint x="630" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T2_di" bpmnElement="Flow_T2">
        <di:waypoint x="710" y="525" />
        <di:waypoint x="742" y="525" />
      </bpmndi:BPMNEdge>

      <!-- メッセージサブプロセス -->
      <bpmndi:BPMNShape id="SubProcess_Message_di" bpmnElement="SubProcess_Message" isExpanded="true">
        <dc:Bounds x="120" y="650" width="400" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Message_di" bpmnElement="StartEvent_Message">
        <dc:Bounds x="152" y="707" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="143" y="750" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cancel_di" bpmnElement="Task_Cancel">
        <dc:Bounds x="220" y="685" width="80" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Rollback_di" bpmnElement="Task_Rollback">
        <dc:Bounds x="330" y="685" width="80" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Message_di" bpmnElement="EndEvent_Message">
        <dc:Bounds x="442" y="707" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="436" y="750" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_M1_di" bpmnElement="Flow_M1">
        <di:waypoint x="188" y="725" />
        <di:waypoint x="220" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M2_di" bpmnElement="Flow_M2">
        <di:waypoint x="300" y="725" />
        <di:waypoint x="330" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M3_di" bpmnElement="Flow_M3">
        <di:waypoint x="410" y="725" />
        <di:waypoint x="442" y="725" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
